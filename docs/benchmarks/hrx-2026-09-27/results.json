  "validation": "full payload/guards/source preservation and all mailbox sequences; clean queue destruction/shutdown",
  "methodology": {
    "compile": "Fresh LoomcCompiler per case, first invocation separately; seven repeated real compile(source) calls bypass JIT disk cache. Compiler initialization and in-process allocator caches may warm. M512 occurs after M1 in same process. No model weights loaded or kernels executed.",
    "bandwidth": "Reusable mapped HOST_VISIBLE|HOST_COHERENT|DEVICE_VISIBLE host buffers and DEVICE_LOCAL VRAM; HRX retained-buffer copy path. Four-KiB guards on both sides. Eight-copy batch with one flush and completion retirement; 1 identical warmup+3 measured batches per size/direction. Sizes4/16/64MiB. Decimal payloadGB/s. Excludes allocation, poisoning, initialization and verification; includes record/flush/wait. Largest64MiB result is recommended for sustained large-buffer transfer reporting. The4MiB H2D rate is cache-sensitive and must not be claimed as physical link bandwidth. Full sweep includes maximum logical-copy rate, not theoretical peak/SDMA claim. Reused-buffer cache residency unqualified.",
    "kernel_latency": "32 warmups +200 measured singleWG32 minimal one-lane4-byte store. HRX record latency and issue(record+flush), completion(record+flush+timeline wait) use host steady clock. Bare HSA publish/doorbell issue and active completion wait separately; CP start/end with fresh paired signal gives GPU-domain dispatch interval. Allocation, loading and validation excluded.",
    "transfer_latency": "32 warmup+256 measured individual8-byte retained-buffer copies per direction. Host steady start through record, flush and completion. This is directional API-to-completion latency, not a pure one-way physical measurement.",
    "pure_latency": "One resident WG32 kernel (lane0 active), shared mapping ownership release/acquire, sequence-numbered8-byte payload, no mixed CPU/GPU RMW. 128warmup+1024measured rounds\u00d73 trials for each initiator. CPU\u2192GPU\u2192CPU uses host steady clock; GPU\u2192CPU\u2192GPU uses gfx1201 MSG_RTN_GET_REALTIME (s_sendmsg_rtn_b64) at live-query GPU timestamp frequency. Initial launch excluded. Timings include poll, ownership publish and responder turnaround. No clock calibration or subtraction across domains; no exact one-way times and no RTT/2 inference.",
    "statistics": "Median/minimum and linearly interpolated sampleP95/P99 (position(n-1)*p); mailbox pooled samples plus per-trial summaries."
  },
  "wait_policy": {
    "MAC_HSA_BLOCKED_POLL_US": null,
    "effective_blocked_poll_us": 1000,
    "HRX_completion_wait": "hrx_semaphore_wait(flags=0) \u2192 AMDGPU epoch wait \u2192 HSA_WAIT_STATE_BLOCKED, fallback1000000ns",
    "HSA_completion_wait": "active hsa_signal_load_scacquire loop, no HSA blocked wait",
    "pure_mailbox_wait": "active atomic_ref acquire polling, no sleep/yield/blocked wait",
