+TEST_F(SymbolicExprTest, FailedTouchDoesNotPublishAnUntrackedMemo) {
+  const auto value = DefineIndexValue();
+  DefineFacts(value, loom_value_facts_exact_i64(7));
+  loom_symbolic_expr_t expression = {};
+  IREE_ASSERT_OK(loom_symbolic_expr_from_value(&expression_context_, value,
+                                               &expression));
+  loom_symbolic_expr_context_reset(&expression_context_);
+  auto* saved_values = expression_context_.touched_memo_values;
+  const auto saved_capacity = expression_context_.touched_memo_capacity;
+  expression_context_.touched_memo_values = nullptr;
+  expression_context_.touched_memo_capacity = 0;
+  iree_arena_block_pool_t failing_pool;
+  iree_arena_allocator_t failing_arena;
+  iree_arena_block_pool_initialize(4096, iree_allocator_null(), &failing_pool);
+  iree_arena_initialize(&failing_pool, &failing_arena);
+  expression_context_.arena = &failing_arena;
+  auto status = loom_symbolic_expr_from_value(&expression_context_, value,
+                                              &expression);
+  EXPECT_FALSE(iree_status_is_ok(status));
+  iree_status_free(status);
+  EXPECT_EQ(expression_context_.touched_memo_count, 0);
+  expression_context_.arena = &analysis_arena_;
+  expression_context_.touched_memo_values = saved_values;
+  expression_context_.touched_memo_capacity = saved_capacity;
+  iree_arena_deinitialize(&failing_arena);
+  iree_arena_block_pool_deinitialize(&failing_pool);
+  DefineFacts(value, loom_value_facts_exact_i64(11));
+  IREE_ASSERT_OK(loom_symbolic_expr_from_value(&expression_context_, value,
+                                               &expression));
+  EXPECT_EQ(expression.constant, 11);
+  EXPECT_EQ(expression_context_.touched_memo_count, 1);
+}
