+TEST_F(SymbolicExprTest, ResetInvalidatesFactOnlyMemoAcrossOppositeScopes) {
+  loom_value_id_t value = DefineIndexValue();
+  DefineFacts(value, loom_value_facts_make(0, 31, 1));
+  auto* sixteen = BuildIndexConstant(16);
+  DefineFacts(loom_index_constant_result(sixteen), loom_value_facts_exact_i64(16));
+  loom_op_t* cmp = nullptr;
+  IREE_ASSERT_OK(loom_index_cmp_build(
+      &builder_, LOOM_INDEX_CMP_PREDICATE_SLT, value,
+      loom_index_constant_result(sixteen),
+      loom_type_scalar(LOOM_SCALAR_TYPE_INDEX),
+      loom_type_scalar(LOOM_SCALAR_TYPE_I1), LOOM_LOCATION_UNKNOWN, &cmp));
+  // Construct the symbolic term without populating the expression memo.
+  loom_symbolic_expr_t expression = {};
+  IREE_ASSERT_OK(loom_symbolic_expr_value(&expression_context_, value,
+                                          &expression));
+  loom_symbolic_expr_t fifteen = {};
+  loom_symbolic_expr_constant(15, &fifteen);
+  loom_condition_integer_relation_t storage[4];
+  loom_condition_fact_set_t facts;
+  loom_condition_fact_set_initialize(storage, IREE_ARRAYSIZE(storage), &facts);
+  for (bool truth : {true, false, true}) {
+    ASSERT_TRUE(loom_condition_facts_query(
+        module_, &fact_table_, loom_index_cmp_result(cmp), truth, &facts));
+    expression_context_.condition_facts = &facts;
+    loom_symbolic_expr_context_reset(&expression_context_);
+    loom_symbolic_proof_result_t result = LOOM_SYMBOLIC_PROOF_UNKNOWN;
+    IREE_ASSERT_OK(loom_symbolic_expr_prove_le(
+        &expression_context_, &expression, &fifteen, &result));
+    EXPECT_EQ(result, truth ? LOOM_SYMBOLIC_PROOF_TRUE
+                            : LOOM_SYMBOLIC_PROOF_FALSE);
+    EXPECT_GT(expression_context_.touched_memo_count, 0);
+  }
+  expression_context_.condition_facts = nullptr;
+  loom_symbolic_expr_context_reset(&expression_context_);
+  loom_symbolic_proof_result_t result = LOOM_SYMBOLIC_PROOF_TRUE;
+  IREE_ASSERT_OK(loom_symbolic_expr_prove_le(
+      &expression_context_, &expression, &fifteen, &result));
+  EXPECT_EQ(result, LOOM_SYMBOLIC_PROOF_UNKNOWN);
+}
