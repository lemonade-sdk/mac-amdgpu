+TEST_F(SymbolicExprTest, ResetInvalidatesSparseMemoAndRetainsCapacity) {
+  loom_value_id_t high = LOOM_VALUE_ID_INVALID;
+  for (int i = 0; i < 1024; ++i) high = DefineIndexValue();
+  DefineFacts(high, loom_value_facts_exact_i64(7));
+  loom_symbolic_expr_t expression = {};
+  IREE_ASSERT_OK(loom_symbolic_expr_from_value(&expression_context_, high,
+                                               &expression));
+  EXPECT_EQ(expression.constant, 7);
+  EXPECT_EQ(expression_context_.touched_memo_count, 1);
+  const auto capacity = expression_context_.memo_capacity;
+  ASSERT_GT(capacity, 1023);
+  IREE_ASSERT_OK(loom_symbolic_expr_from_value(&expression_context_, high,
+                                               &expression));
+  EXPECT_EQ(expression_context_.touched_memo_count, 1);
+  DefineFacts(high, loom_value_facts_exact_i64(11));
+  EXPECT_EQ(expression_context_.touched_memo_count, 0);
+  EXPECT_EQ(expression_context_.memo_capacity, capacity);
+  IREE_ASSERT_OK(loom_symbolic_expr_from_value(&expression_context_, high,
+                                               &expression));
+  EXPECT_EQ(expression.constant, 11);
+  EXPECT_EQ(expression_context_.touched_memo_count, 1);
+  loom_symbolic_expr_context_reset(&expression_context_);
+  loom_symbolic_expr_context_reset(&expression_context_);
+  EXPECT_EQ(expression_context_.touched_memo_count, 0);
+}
