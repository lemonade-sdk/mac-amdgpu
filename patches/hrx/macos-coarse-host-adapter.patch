+      HSA_AGENT_INFO_QUEUE_MAX_SIZE, &queue_size_max));
+  if (queue_size_max < 64 || !iree_host_size_is_power_of_two(queue_size_max)) {
+    IREE_RETURN_AND_END_ZONE_IF_ERROR(z0, iree_make_status(
+        IREE_STATUS_FAILED_PRECONDITION, "invalid macOS HSA queue capacity"));
+  }
+  if (resolved_options.host_queues.aql_capacity > queue_size_max) {
+    resolved_options.host_queues.aql_capacity = queue_size_max;
+  }
+  resolved_options.command_buffer_mode = IREE_HAL_AMDGPU_COMMAND_BUFFER_MODE_AQL;
+  // Timeline dependencies are resolved by the host until vendor PM4 packets
+  // are separately validated on this transport.
+  resolved_options.force_wait_barrier_defer = true;
