diff --git a/loom/src/loom/transforms/kernel/stage_matrix_operands.c b/loom/src/loom/transforms/kernel/stage_matrix_operands.c
new file mode 100644
index 00000000..5d1a6cc5
--- /dev/null
+++ b/loom/src/loom/transforms/kernel/stage_matrix_operands.c
@@ -0,0 +1,1210 @@
+// Copyright 2026 The IREE Authors
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#include "loom/transforms/kernel/stage_matrix_operands.h"
+
+#include <string.h>
+
+#include "iree/base/internal/arena.h"
+#include "loom/analysis/control_uniformity.h"
+#include "loom/codegen/low/pipeline/pass_environment.h"
+#include "loom/ir/context.h"
+#include "loom/ir/module.h"
+#include "loom/ops/buffer/ops.h"
+#include "loom/ops/encoding/ops.h"
+#include "loom/ops/index/ops.h"
+#include "loom/ops/kernel/launch_config.h"
+#include "loom/ops/kernel/ops.h"
+#include "loom/ops/scalar/ops.h"
+#include "loom/ops/scf/ops.h"
+#include "loom/ops/vector/ops.h"
+#include "loom/ops/view/ops.h"
+#include "loom/pass/value_facts.h"
+#include "loom/rewrite/materialize.h"
+#include "loom/rewrite/remap.h"
+#include "loom/rewrite/rewriter.h"
+#include "loom/target/facts.h"
+#include "loom/target/launch.h"
+#include "loom/target/pass_environment.h"
+#include "loom/target/reporting/report.h"
+#include "loom/util/walk.h"
+
+static const loom_pass_info_t pass_info = {
+    .name = IREE_SVL("stage-matrix-operands"),
+    .description = IREE_SVL("Cooperatively load independent matrix operand "
+                            "elements through workgroup memory."),
+    .kind = LOOM_PASS_FUNCTION,
+};
+const loom_pass_info_t* loom_stage_matrix_operands_pass_info(void) {
+  return &pass_info;
+}
+
+typedef struct context_t {
+  loom_pass_t* pass;
+  loom_module_t* module;
+  loom_func_like_t function;
+  loom_rewriter_t rw;
+  loom_control_uniformity_info_t uniformity;
+  loom_op_t** candidates;
+  iree_host_size_t count, capacity;
+  // One reusable allocation per element type; every consumer ends with a
+  // barrier.
+  loom_value_id_t staging[2];
+  uint8_t* dependence;
+  loom_op_t* producer;
+  loom_ir_remap_t remap;
+  loom_value_id_t mapped_lane;
+  // Per-run congruence classes share reads and conversions inside one mask.
+  uint8_t* run_classes;
+  loom_value_id_t* run_values;
+  loom_value_id_t run_value_count;
+  unsigned run_component;
+  uint64_t workgroup_bytes, storage_limit;
+  bool unknown_storage;
+  loom_target_compile_report_t* report;
+} context_t;
+
+static loom_op_t* defining(context_t* c, loom_value_id_t id) {
+  const loom_value_t* v = loom_value_table_const_value(&c->module->values, id);
+  return loom_value_is_block_arg(v) ? NULL : loom_value_def_op(v);
+}
+static bool within(loom_op_t* op, loom_op_t* ancestor) {
+  for (; op; op = op->parent_op)
+    if (op == ancestor) return true;
+  return false;
+}
+static bool exact(context_t* c, loom_value_id_t v, int64_t n) {
+  int64_t value = 0;
+  return loom_value_facts_as_exact_i64(loom_rewriter_value_facts(&c->rw, v),
+                                       &value) &&
+         value == n;
+}
+// 1: lane independent, 2: reproducible for another lane, 3: unsupported.
+static uint8_t dependency(context_t* c, loom_value_id_t v) {
+  if (c->dependence[v]) return c->dependence[v];
+  uint8_t result = 1;
+  loom_value_facts_t facts = loom_rewriter_value_facts(&c->rw, v);
+  if (loom_value_facts_is_uniform_at_scope(
+          facts, LOOM_VALUE_FACT_UNIFORM_SCOPE_WORKGROUP))
+    return c->dependence[v] = 1;
+  loom_op_t* op = defining(c, v);
+  if (!op) {
+    const loom_value_t* value =
+        loom_value_table_const_value(&c->module->values, v);
+    return c->dependence[v] =
+               loom_value_def_block(value) ==
+                       loom_region_entry_block(loom_func_like_body(c->function))
+                   ? 1
+                   : 3;
+  }
+  if (loom_kernel_workitem_id_isa(op))
+    return c->dependence[v] =
+               loom_kernel_workitem_id_dimension(op) == LOOM_KERNEL_DIMENSION_X
+                   ? 2
+                   : 3;
+  // Do not reconstruct values produced by loops or participant-dependent ops.
+  if ((op->region_count && !loom_scf_if_isa(op)) ||
+      loom_traits_has_side_effects(op->traits) ||
+      (op->traits & (LOOM_TRAIT_CONVERGENT | LOOM_TRAIT_UNIQUE_IDENTITY)))
+    return c->dependence[v] = 3;
+  c->dependence[v] = 3;
+  for (uint16_t i = 0; i < op->operand_count; ++i) {
+    uint8_t d = dependency(c, loom_op_operands(op)[i]);
+    if (d > result) result = d;
+  }
+  // A previous load may precede an intervening store. Reconstruct only
+  // reads already inside the producer; uniform values can be reused as SSA.
+  if (result == 2 && !within(op, c->producer) &&
+      (op->traits & LOOM_TRAIT_READS_MEMORY))
+    result = 3;
+  if (loom_scf_if_isa(op)) {
+    const loom_value_t* value =
+        loom_value_table_const_value(&c->module->values, v);
+    uint16_t ordinal = loom_value_def_index(value);
+    for (uint16_t r = 0; r < op->region_count; ++r) {
+      loom_op_t* yield =
+          loom_region_entry_block(loom_op_regions(op)[r])->last_op;
+      uint8_t d = dependency(c, loom_scf_yield_values(yield).values[ordinal]);
+      if (d > result) result = d;
+    }
+    // A varying structured producer requires region-aware motion; leave it.
+    if (result == 2) result = 3;
+  }
+  return c->dependence[v] = result;
+}
+static bool check_external(context_t* c, loom_op_t* op) {
+  for (uint16_t i = 0; i < op->operand_count; ++i) {
+    loom_value_id_t v = loom_op_operands(op)[i];
+    const loom_value_t* value =
+        loom_value_table_const_value(&c->module->values, v);
+    if (loom_value_is_block_arg(value) &&
+        loom_value_def_block(value) ==
+            loom_region_entry_block(loom_scf_for_body(c->producer)))
+      continue;
+    loom_op_t* def = defining(c, v);
+    if (def && within(def, c->producer)) continue;
+    if (dependency(c, v) == 3) {
+      return false;
+    }
+  }
+  for (uint16_t r = 0; r < op->region_count; ++r) {
+    loom_region_t* region = loom_op_regions(op)[r];
+    for (uint16_t b = 0; b < region->block_count; ++b)
+      for (loom_op_t* child = region->blocks[b]->first_op; child;
+           child = child->next_op)
+        if (!check_external(c, child)) return false;
+  }
+  return true;
+}
+static bool independent_body(loom_op_t* op) {
+  if (loom_traits_has_side_effects(op->traits) ||
+      (op->traits & LOOM_TRAIT_CONVERGENT))
+    return false;
+  if (loom_op_dialect_id(op->kind) == LOOM_DIALECT_VECTOR &&
+      !loom_vector_insert_isa(op) && !loom_vector_constant_isa(op) &&
+      !loom_vector_splat_isa(op) && !loom_vector_bitcast_isa(op) &&
+      !loom_vector_extract_isa(op))
+    return false;
+  if (op->region_count && !loom_scf_if_isa(op)) return false;
+  for (uint16_t r = 0; r < op->region_count; ++r) {
+    loom_region_t* region = loom_op_regions(op)[r];
+    for (uint16_t b = 0; b < region->block_count; ++b)
+      for (loom_op_t* child = region->blocks[b]->first_op; child;
+           child = child->next_op)
+        if (!independent_body(child)) return false;
+  }
+  return true;
+}
+// A result element must be written at the loop IV, or retain its initial value.
+// This excludes recurrences between payload components.
+static bool global_scalar_read(context_t* c, loom_value_id_t v,
+                               unsigned depth) {
+  if (depth > 64) return false;
+  loom_op_t* op = defining(c, v);
+  if (!op) return false;
+  if (loom_view_load_isa(op)) {
+    loom_op_t* view = defining(c, loom_view_load_view(op));
+    if (!view || !loom_buffer_view_isa(view)) return false;
+    loom_value_id_t buffer = loom_buffer_view_buffer(view);
+    loom_op_t* root = defining(c, buffer);
+    if (root && loom_buffer_assume_noalias_isa(root)) {
+      uint16_t index = loom_value_def_index(
+          loom_value_table_const_value(&c->module->values, buffer));
+      buffer = loom_op_operands(root)[index];
+      root = defining(c, buffer);
+    }
+    return !root || loom_buffer_from_address_isa(root);
+  }
+  if (op->region_count || !(op->traits & LOOM_TRAIT_PURE)) return false;
+  for (uint16_t i = 0; i < op->operand_count; ++i)
+    if (global_scalar_read(c, loom_op_operands(op)[i], depth + 1)) return true;
+  return false;
+}
+// Conversions may use small vectors, but must not read a carried payload.
+static bool independent_scalar(context_t* c, loom_value_id_t v,
+                               unsigned depth) {
+  if (depth > 128) return false;
+  const loom_value_t* value =
+      loom_value_table_const_value(&c->module->values, v);
+  if (loom_value_is_block_arg(value)) {
+    loom_block_t* block =
+        loom_region_entry_block(loom_scf_for_body(c->producer));
+    return loom_value_def_block(value) != block ||
+           v == loom_block_arg_id(block, 0);
+  }
+  loom_op_t* op = defining(c, v);
+  if (!within(op, c->producer)) return true;
+  for (uint16_t i = 0; i < op->operand_count; ++i)
+    if (!independent_scalar(c, loom_op_operands(op)[i], depth + 1))
+      return false;
+  return true;
+}
+static bool pointwise(context_t* c, loom_value_id_t v, loom_value_id_t carried,
+                      loom_value_id_t iv, bool* has_load) {
+  if (v == carried) return true;
+  loom_op_t* op = defining(c, v);
+  if (!op) return false;
+  if (loom_vector_insert_isa(op)) {
+    loom_value_slice_t indices = loom_vector_insert_indices(op);
+    if (indices.count != 1 || indices.values[0] != iv) return false;
+    if (!independent_scalar(c, loom_vector_insert_value(op), 0)) return false;
+    *has_load |= global_scalar_read(c, loom_vector_insert_value(op), 0);
+    return pointwise(c, loom_vector_insert_dest(op), carried, iv, has_load);
+  }
+  if (loom_scf_if_isa(op)) {
+    if (!independent_scalar(c, loom_scf_if_condition(op), 0)) return false;
+    const loom_value_t* value =
+        loom_value_table_const_value(&c->module->values, v);
+    uint16_t ordinal = loom_value_def_index(value);
+    if (op->region_count != 2) return false;
+    for (uint16_t r = 0; r < 2; ++r) {
+      loom_block_t* block = loom_region_entry_block(loom_op_regions(op)[r]);
+      if (!block || !block->last_op || !loom_scf_yield_isa(block->last_op))
+        return false;
+      if (!pointwise(c, loom_scf_yield_values(block->last_op).values[ordinal],
+                     carried, iv, has_load))
+        return false;
+    }
+    return true;
+  }
+  return false;
+}
+
+static iree_status_t constant(context_t* c, int64_t n, loom_scalar_type_t t,
+                              loom_value_id_t* out) {
+  loom_op_t* op = NULL;
+  IREE_RETURN_IF_ERROR(loom_index_constant_build(
+      &c->rw.builder, loom_attr_i64(n), loom_type_scalar(t),
+      c->producer->location, &op));
+  *out = loom_index_constant_result(op);
+  return iree_ok_status();
+}
+typedef iree_status_t (*binary_fn_t)(loom_builder_t*, loom_value_id_t,
+                                     loom_value_id_t, loom_type_t,
+                                     loom_location_id_t, loom_op_t**);
+static iree_status_t binary(context_t* c, binary_fn_t fn, loom_value_id_t a,
+                            loom_value_id_t b, loom_value_id_t* out) {
+  loom_op_t* op = NULL;
+  IREE_RETURN_IF_ERROR(fn(&c->rw.builder, a, b,
+                          loom_type_scalar(LOOM_SCALAR_TYPE_INDEX),
+                          c->producer->location, &op));
+  *out = loom_op_results(op)[0];
+  return iree_ok_status();
+}
+static iree_status_t barrier(context_t* c) {
+  loom_op_t* op = NULL;
+  return loom_kernel_barrier_build(
+      &c->rw.builder, LOOM_VALUE_FACT_MEMORY_SPACE_WORKGROUP,
+      LOOM_ATOMIC_ORDERING_ACQ_REL, LOOM_ATOMIC_SCOPE_WORKGROUP,
+      c->producer->location, &op);
+}
+
+// Track an eight-element lane run as base + stride * component. Alignment is
+// for component zero. Division/remainder can discard the component only when
+// the complete run stays in one aligned interval.
+typedef struct run_t {
+  int64_t stride;
+  uint64_t alignment;
+  bool valid;
+} run_t;
+static uint64_t alignment(int64_t x) {
+  uint64_t u = (uint64_t)x;
+  return u ? (u & (~u + 1)) : (UINT64_C(1) << 32);
+}
+static run_t run(context_t* c, loom_value_id_t v) {
+  const run_t bad = {0, 1, false};
+  int64_t known = 0;
+  if (loom_value_facts_as_exact_i64(loom_rewriter_value_facts(&c->rw, v),
+                                    &known))
+    return (run_t){0, alignment(known), true};
+  loom_op_t* op = defining(c, v);
+  if (!op) return (run_t){0, 1, true};
+  if (loom_kernel_workitem_id_isa(op)) return (run_t){1, 8, true};
+  if (!within(op, c->producer) && dependency(c, v) == 1)
+    return (run_t){0, 1, true};
+  if (op->region_count || op->operand_count > 3) return bad;
+  run_t args[3] = {{0, 1, true}, {0, 1, true}, {0, 1, true}};
+  bool varies = false;
+  for (uint16_t i = 0; i < op->operand_count; ++i) {
+    args[i] = run(c, loom_op_operands(op)[i]);
+    if (!args[i].valid) return bad;
+    varies |= args[i].stride != 0;
+  }
+  for (uint16_t i = 0; i < op->operand_count; ++i)
+    if (args[i].stride < -INT64_C(4294967296) ||
+        args[i].stride > INT64_C(4294967296))
+      return bad;
+  uint64_t align = iree_min(args[0].alignment, args[1].alignment);
+  switch (op->kind) {
+    case LOOM_OP_INDEX_ADD:
+      return (run_t){args[0].stride + args[1].stride, align, true};
+    case LOOM_OP_INDEX_SUB:
+      return (run_t){args[0].stride - args[1].stride, align, true};
+    case LOOM_OP_INDEX_MUL: {
+      if (!varies)
+        return (run_t){0,
+                       iree_min(args[0].alignment, UINT64_C(1) << 16) *
+                           iree_min(args[1].alignment, UINT64_C(1) << 16),
+                       true};
+      int other = args[0].stride ? 1 : 0, varying = 1 - other;
+      if (args[other].stride ||
+          !loom_value_facts_as_exact_i64(
+              loom_rewriter_value_facts(&c->rw, loom_op_operands(op)[other]),
+              &known) ||
+          known < 0 || known > 65536)
+        return bad;
+      if (args[varying].stride < 0 || args[varying].stride > 65536) return bad;
+      return (run_t){args[varying].stride * known,
+                     iree_min(args[varying].alignment, UINT64_C(1) << 16) *
+                         iree_min(alignment(known), UINT64_C(1) << 16),
+                     true};
+    }
+    case LOOM_OP_INDEX_CAST:
+    case LOOM_OP_INDEX_ASSUME:
+      return args[0];
+    case LOOM_OP_INDEX_DIV:
+    case LOOM_OP_INDEX_REM: {
+      if (!varies) return (run_t){0, 1, true};
+      if (args[1].stride ||
+          !loom_value_facts_as_exact_i64(
+              loom_rewriter_value_facts(&c->rw, loom_op_operands(op)[1]),
+              &known) ||
+          known <= 0 || (known & (known - 1)))
+        return bad;
+      uint64_t step = iree_min(args[0].alignment, (uint64_t)known);
+      if (args[0].stride < 0 || (uint64_t)args[0].stride >= ((step + 6) / 7))
+        return bad;
+      if (op->kind == LOOM_OP_INDEX_DIV)
+        return (run_t){
+            0, iree_max(args[0].alignment / (uint64_t)known, UINT64_C(1)),
+            true};
+      return (run_t){args[0].stride, step, true};
+    }
+    case LOOM_OP_INDEX_CMP: {
+      if (!varies) return (run_t){0, 1, true};
+      // Strict less-than cannot change inside an aligned eight-element run
+      // when both endpoints are multiples of eight.
+      if ((loom_index_cmp_predicate(op) == LOOM_INDEX_CMP_PREDICATE_ULT ||
+           loom_index_cmp_predicate(op) == LOOM_INDEX_CMP_PREDICATE_SLT) &&
+          args[0].stride == 1 && args[1].stride == 0 && align >= 8)
+        return (run_t){0, 1, true};
+      return bad;
+    }
+    default:
+      return varies ? bad : (run_t){0, 1, true};
+  }
+}
+// Exact offsets within the redistributed eight-column run. Packed bytes
+// produce repeated word offsets (0,0,0,0,1,1,1,1), not an affine scalar stride.
+typedef struct sequence_t {
+  int64_t delta[8];
+  uint64_t alignment;
+  bool valid;
+} sequence_t;
+static sequence_t sequence(context_t* c, loom_value_id_t v, unsigned depth) {
+  sequence_t bad = {0};
+  if (depth > 128) return bad;
+  run_t affine = run(c, v);
+  if (affine.valid) {
+    sequence_t out = {.alignment = affine.alignment, .valid = true};
+    if (affine.stride < -INT64_C(4294967296) ||
+        affine.stride > INT64_C(4294967296))
+      return bad;
+    for (unsigned i = 0; i < 8; ++i) out.delta[i] = affine.stride * i;
+    return out;
+  }
+  loom_op_t* op = defining(c, v);
+  if (!op || op->region_count || !op->operand_count || op->operand_count > 3)
+    return bad;
+  sequence_t a[3] = {0};
+  for (unsigned i = 0; i < op->operand_count; ++i) {
+    a[i] = sequence(c, loom_op_operands(op)[i], depth + 1);
+    if (!a[i].valid) return bad;
+  }
+  sequence_t out = {.alignment = iree_min(a[0].alignment, a[1].alignment),
+                    .valid = true};
+  switch (op->kind) {
+    case LOOM_OP_INDEX_CAST:
+    case LOOM_OP_INDEX_ASSUME:
+      return a[0];
+    case LOOM_OP_INDEX_ADD:
+    case LOOM_OP_INDEX_SUB:
+      for (unsigned i = 0; i < 8; ++i) {
+        if (a[0].delta[i] < -INT64_C(4294967296) ||
+            a[0].delta[i] > INT64_C(4294967296) ||
+            a[1].delta[i] < -INT64_C(4294967296) ||
+            a[1].delta[i] > INT64_C(4294967296))
+          return bad;
+        out.delta[i] =
+            a[0].delta[i] +
+            (op->kind == LOOM_OP_INDEX_ADD ? a[1].delta[i] : -a[1].delta[i]);
+      }
+      return out;
+    case LOOM_OP_INDEX_DIV:
+    case LOOM_OP_INDEX_REM: {
+      int64_t divisor = 0;
+      if (!loom_value_facts_as_exact_i64(
+              loom_rewriter_value_facts(&c->rw, loom_op_operands(op)[1]),
+              &divisor) ||
+          divisor <= 0 || (divisor & (divisor - 1)) ||
+          a[0].alignment < (uint64_t)divisor)
+        return bad;
+      out.alignment =
+          op->kind == LOOM_OP_INDEX_DIV ? a[0].alignment / divisor : divisor;
+      for (unsigned i = 0; i < 8; ++i) {
+        if (a[0].delta[i] < 0) return bad;
+        out.delta[i] = op->kind == LOOM_OP_INDEX_DIV ? a[0].delta[i] / divisor
+                                                     : a[0].delta[i] % divisor;
+      }
+      return out;
+    }
+    default:
+      return bad;
+  }
+}
+static bool converted_read(context_t* c, loom_op_t* op, bool* coalesced) {
+  loom_value_slice_t indices = loom_view_load_indices(op);
+  if (indices.count != 1) return false;
+  loom_value_id_t at = indices.values[0];
+  // Fragment boundaries are resolved independently for each scalar access.
+  // Strip wrapping only for the profitability check, never for code generation.
+  for (;;) {
+    loom_op_t* address = defining(c, at);
+    if (!address) break;
+    if (loom_index_assume_isa(address) || loom_index_cast_isa(address)) {
+      at = loom_op_operands(address)[0];
+      continue;
+    }
+    int64_t modulus = 0;
+    if (loom_index_rem_isa(address) &&
+        loom_value_facts_as_exact_i64(
+            loom_rewriter_value_facts(&c->rw, loom_op_operands(address)[1]),
+            &modulus) &&
+        modulus >= 32) {
+      at = loom_op_operands(address)[0];
+      continue;
+    }
+    break;
+  }
+  sequence_t seq = sequence(c, at, 0);
+  if (!seq.valid) return false;
+  bool uniform = true, contiguous = true, packed = true;
+  for (unsigned i = 0; i < 8; ++i) {
+    uniform &= seq.delta[i] == 0;
+    contiguous &= seq.delta[i] == i;
+    packed &= seq.delta[i] == i / 4;
+  }
+  *coalesced |= contiguous || packed;
+  return uniform || contiguous || packed;
+}
+static bool converted_scalar(context_t* c, loom_value_id_t v, bool* coalesced,
+                             unsigned depth) {
+  if (depth > 128) return false;
+  loom_op_t* op = defining(c, v);
+  if (!op || (!within(op, c->producer) && dependency(c, v) == 1)) return true;
+  if (loom_view_load_isa(op)) return converted_read(c, op, coalesced);
+  if (op->region_count || !(op->traits & LOOM_TRAIT_PURE)) return false;
+  for (unsigned i = 0; i < op->operand_count; ++i)
+    if (!converted_scalar(c, loom_op_operands(op)[i], coalesced, depth + 1))
+      return false;
+  return true;
+}
+static bool convertible(context_t* c, loom_value_id_t v,
+                        loom_value_id_t carried, bool* coalesced) {
+  if (v == carried) {
+    loom_op_t* init = defining(
+        c, loom_scf_for_iter_args(c->producer)
+               .values[loom_value_def_index(loom_value_table_const_value(
+                           &c->module->values, v)) -
+                       1]);
+    return init && loom_vector_constant_isa(init);
+  }
+  loom_op_t* op = defining(c, v);
+  if (!op) return false;
+  if (loom_vector_insert_isa(op))
+    return converted_scalar(c, loom_vector_insert_value(op), coalesced, 0);
+  if (!loom_scf_if_isa(op)) return false;
+  // Each scalar keeps its original predicate. No masked vector overread.
+  unsigned ordinal =
+      loom_value_def_index(loom_value_table_const_value(&c->module->values, v));
+  for (unsigned r = 0; r < op->region_count; ++r) {
+    loom_op_t* yield = loom_region_entry_block(loom_op_regions(op)[r])->last_op;
+    if (!convertible(c, loom_scf_yield_values(yield).values[ordinal], carried,
+                     coalesced))
+      return false;
+  }
+  return true;
+}
+static bool vectorizable(context_t* c, loom_value_id_t v,
+                         loom_value_id_t carried) {
+  if (v == carried) {
+    loom_op_t* init = defining(
+        c, loom_scf_for_iter_args(c->producer)
+               .values[loom_value_def_index(loom_value_table_const_value(
+                           &c->module->values, v)) -
+                       1]);
+    return init && loom_vector_constant_isa(init);
+  }
+  loom_op_t* op = defining(c, v);
+  if (!op) return false;
+  if (loom_vector_insert_isa(op)) {
+    loom_value_id_t scalar = loom_vector_insert_value(op);
+    loom_op_t* leaf = defining(c, scalar);
+    if (leaf && loom_view_load_isa(leaf)) {
+      loom_value_slice_t indices = loom_view_load_indices(leaf);
+      if (indices.count != 1 || loom_type_rank(loom_module_value_type(
+                                    c->module, loom_view_load_view(leaf))) != 1)
+        return false;
+      run_t address = run(c, indices.values[0]),
+            view = run(c, loom_view_load_view(leaf));
+
+      return address.valid && address.stride == 1 && address.alignment >= 8 &&
+             view.valid && view.stride == 0;
+    }
+    // A scalar constant (including a narrowing cast of zero) can be splatted.
+    return leaf && ((leaf->traits & LOOM_TRAIT_CONSTANT_LIKE) ||
+                    (loom_scalar_fptrunc_isa(leaf) &&
+                     defining(c, loom_op_operands(leaf)[0]) &&
+                     (defining(c, loom_op_operands(leaf)[0])->traits &
+                      LOOM_TRAIT_CONSTANT_LIKE)));
+  }
+  if (loom_scf_if_isa(op)) {
+    run_t condition = run(c, loom_scf_if_condition(op));
+    if (!condition.valid || condition.stride) {
+      return false;
+    }
+    uint16_t ordinal = loom_value_def_index(
+        loom_value_table_const_value(&c->module->values, v));
+    for (uint16_t r = 0; r < op->region_count; ++r) {
+      loom_op_t* yield =
+          loom_region_entry_block(loom_op_regions(op)[r])->last_op;
+      if (!vectorizable(c, loom_scf_yield_values(yield).values[ordinal],
+                        carried))
+        return false;
+    }
+    return true;
+  }
+  return false;
+}
+static uint8_t run_class(context_t* c, loom_value_id_t v, unsigned component) {
+  uint8_t* entry = &c->run_classes[(iree_host_size_t)v * 8 + component];
+  if (*entry != UINT8_MAX) return *entry;
+  *entry = component;
+  if (!component) return 0;
+  sequence_t seq = sequence(c, v, 0);
+  if (seq.valid) {
+    for (unsigned i = 0; i < component; ++i)
+      if (seq.delta[i] == seq.delta[component])
+        return *entry = run_class(c, v, i);
+    return *entry;
+  }
+  loom_op_t* op = defining(c, v);
+  if (!op || op->region_count) return *entry;
+  for (unsigned i = 0; i < component; ++i) {
+    bool same = true;
+    for (unsigned j = 0; j < op->operand_count && same; ++j) {
+      loom_value_id_t input = loom_op_operands(op)[j];
+      same = run_class(c, input, component) == run_class(c, input, i);
+    }
+    if (same) return *entry = run_class(c, v, i);
+  }
+  return *entry;
+}
+static iree_status_t clone_value(context_t* c, loom_value_id_t v,
+                                 loom_value_id_t* result);
+static iree_status_t clone_value_uncached(context_t* c, loom_value_id_t v,
+
+                                          loom_value_id_t* result) {
+  if (loom_ir_remap_try_lookup_value(&c->remap, v, result))
+    return iree_ok_status();
+  loom_op_t* op = defining(c, v);
+  if (!op || (!within(op, c->producer) && dependency(c, v) == 1)) {
+    *result = v;
+    return iree_ok_status();
+  }
+  if (loom_kernel_workitem_id_isa(op)) {
+    *result = c->mapped_lane;
+    return iree_ok_status();
+  }
+  for (uint16_t i = 0; i < op->operand_count; ++i) {
+    loom_value_id_t old = loom_op_operands(op)[i], mapped;
+    IREE_RETURN_IF_ERROR(clone_value(c, old, &mapped));
+    IREE_RETURN_IF_ERROR(loom_ir_remap_map_value(&c->remap, old, mapped));
+  }
+  loom_op_t* cloned = NULL;
+  IREE_RETURN_IF_ERROR(
+      loom_ir_clone_op(&c->rw.builder, op, &c->remap, &cloned));
+  return loom_ir_remap_resolve_value(&c->remap, v, result);
+}
+static iree_status_t clone_value(context_t* c, loom_value_id_t v,
+                                 loom_value_id_t* result) {
+  if (!c->run_values || v >= c->run_value_count)
+    return clone_value_uncached(c, v, result);
+  uint8_t group = run_class(c, v, c->run_component);
+  loom_value_id_t* cached = &c->run_values[(iree_host_size_t)v * 8 + group];
+  if (*cached != LOOM_VALUE_ID_INVALID) {
+    *result = *cached;
+    return iree_ok_status();
+  }
+  IREE_RETURN_IF_ERROR(clone_value_uncached(c, v, result));
+  *cached = *result;
+  return iree_ok_status();
+}
+static iree_status_t fresh_remap(context_t* c, loom_value_id_t oldf) {
+  IREE_RETURN_IF_ERROR(loom_ir_remap_initialize(
+      c->module, c->module, c->pass->arena,
+      &(loom_ir_remap_options_t){.allow_unmapped_values = true}, &c->remap));
+  return loom_ir_remap_map_value(
+      &c->remap,
+      loom_block_arg_id(loom_region_entry_block(loom_scf_for_body(c->producer)),
+                        0),
+      oldf);
+}
+static iree_status_t load_run(context_t* c, loom_value_id_t v,
+                              loom_value_id_t carried, loom_value_id_t oldf,
+                              loom_type_t payload, loom_value_id_t* result) {
+  loom_op_t *op = defining(c, v), *built = NULL;
+  if (v == carried) {
+    *result = loom_scf_for_iter_args(c->producer)
+                  .values[loom_value_def_index(loom_value_table_const_value(
+                              &c->module->values, v)) -
+                          1];
+    return iree_ok_status();
+  }
+  IREE_RETURN_IF_ERROR(fresh_remap(c, oldf));
+  if (loom_vector_insert_isa(op)) {
+    loom_value_id_t scalar = loom_vector_insert_value(op);
+    loom_op_t* leaf = defining(c, scalar);
+    if (loom_view_load_isa(leaf)) {
+      loom_value_id_t view, index;
+      IREE_RETURN_IF_ERROR(clone_value(c, loom_view_load_view(leaf), &view));
+      IREE_RETURN_IF_ERROR(
+          clone_value(c, loom_view_load_indices(leaf).values[0], &index));
+      // The run proof establishes an eight-element-aligned base. Express
+      // that identity so footprint analysis also sees the tightened upper
+      // bound.
+      loom_value_id_t width, quotient, aligned;
+      IREE_RETURN_IF_ERROR(constant(c, 8, LOOM_SCALAR_TYPE_INDEX, &width));
+      IREE_RETURN_IF_ERROR(
+          binary(c, loom_index_div_build, index, width, &quotient));
+      IREE_RETURN_IF_ERROR(
+          binary(c, loom_index_mul_build, quotient, width, &aligned));
+      index = aligned;
+      int64_t dynamic = INT64_MIN;
+      uint32_t flags = 0;
+      if (!loom_attr_is_absent(
+              loom_op_attrs(leaf)[loom_view_load_cache_scope_ATTR_INDEX]))
+        flags |= LOOM_VECTOR_LOAD_BUILD_FLAG_HAS_CACHE_SCOPE;
+      if (!loom_attr_is_absent(
+              loom_op_attrs(leaf)[loom_view_load_cache_temporal_ATTR_INDEX]))
+        flags |= LOOM_VECTOR_LOAD_BUILD_FLAG_HAS_CACHE_TEMPORAL;
+      IREE_RETURN_IF_ERROR(loom_vector_load_build(
+          &c->rw.builder, flags, view, &index, 1, &dynamic, 1,
+          loom_view_load_cache_scope(leaf), loom_view_load_cache_temporal(leaf),
+          payload, op->location, &built));
+      *result = loom_vector_load_result(built);
+    } else {
+      loom_value_id_t mapped;
+      IREE_RETURN_IF_ERROR(clone_value(c, scalar, &mapped));
+      IREE_RETURN_IF_ERROR(loom_vector_splat_build(
+          &c->rw.builder, mapped, payload, op->location, &built));
+      *result = loom_vector_splat_result(built);
+    }
+    return iree_ok_status();
+  }
+  loom_value_id_t condition;
+  IREE_RETURN_IF_ERROR(clone_value(c, loom_scf_if_condition(op), &condition));
+  IREE_RETURN_IF_ERROR(
+      loom_scf_if_build(&c->rw.builder, LOOM_SCF_IF_BUILD_FLAG_HAS_ELSE_REGION,
+                        condition, &payload, 1, NULL, 0, op->location, &built));
+  uint16_t ordinal =
+      loom_value_def_index(loom_value_table_const_value(&c->module->values, v));
+  for (uint16_t r = 0; r < 2; ++r) {
+    loom_builder_ip_t ip = loom_builder_enter_region(&c->rw.builder, built,
+                                                     loom_op_regions(built)[r]);
+    loom_op_t* yield = loom_region_entry_block(loom_op_regions(op)[r])->last_op;
+    loom_value_id_t branch;
+    IREE_RETURN_IF_ERROR(load_run(c,
+                                  loom_scf_yield_values(yield).values[ordinal],
+                                  carried, oldf, payload, &branch));
+    loom_op_t* new_yield = NULL;
+    IREE_RETURN_IF_ERROR(loom_scf_yield_build(&c->rw.builder, &branch, 1,
+                                              op->location, &new_yield));
+    loom_builder_restore(&c->rw.builder, ip);
+  }
+  *result = loom_scf_if_results(built).values[0];
+  return iree_ok_status();
+}
+static bool uniform_masks(context_t* c, loom_value_id_t v,
+                          loom_value_id_t carried) {
+  if (v == carried) return true;
+  loom_op_t* op = defining(c, v);
+  if (loom_vector_insert_isa(op)) return true;
+  run_t mask = run(c, loom_scf_if_condition(op));
+  if (!mask.valid || mask.stride) return false;
+  unsigned ordinal =
+      loom_value_def_index(loom_value_table_const_value(&c->module->values, v));
+  for (unsigned r = 0; r < 2; ++r) {
+    loom_op_t* yield = loom_region_entry_block(loom_op_regions(op)[r])->last_op;
+    if (!uniform_masks(c, loom_scf_yield_values(yield).values[ordinal],
+                       carried))
+      return false;
+  }
+  return true;
+}
+// Keep invariant masks outside the complete run so CSE can share packed words,
+// scales and fragment pointers across converted elements before vector
+// lowering.
+static iree_status_t load_converted_run(context_t* c, loom_value_id_t v,
+                                        loom_value_id_t carried,
+                                        loom_value_id_t oldf,
+                                        loom_type_t payload,
+                                        loom_value_id_t* result) {
+  loom_op_t* op = defining(c, v);
+  if (v == carried) {
+    *result = loom_scf_for_iter_args(c->producer)
+                  .values[loom_value_def_index(loom_value_table_const_value(
+                              &c->module->values, v)) -
+                          1];
+    return iree_ok_status();
+  }
+  loom_value_id_t base_lane = c->mapped_lane;
+  if (loom_vector_insert_isa(op)) {
+    loom_op_t* made = NULL;
+    IREE_RETURN_IF_ERROR(loom_vector_constant_build(
+        &c->rw.builder, loom_attr_f64(0.0), payload, op->location, &made));
+    loom_value_id_t packed = loom_vector_constant_result(made);
+    c->run_value_count = c->module->values.count;
+    iree_host_size_t count = (iree_host_size_t)c->run_value_count * 8;
+    IREE_RETURN_IF_ERROR(iree_arena_allocate_array(c->pass->arena, count,
+                                                   sizeof(*c->run_classes),
+                                                   (void**)&c->run_classes));
+    IREE_RETURN_IF_ERROR(iree_arena_allocate_array(
+        c->pass->arena, count, sizeof(*c->run_values), (void**)&c->run_values));
+    for (iree_host_size_t i = 0; i < count; ++i) {
+      c->run_classes[i] = UINT8_MAX;
+      c->run_values[i] = LOOM_VALUE_ID_INVALID;
+    }
+    for (unsigned i = 0; i < 8; ++i) {
+      c->run_component = i;
+      loom_value_id_t component, scalar;
+      IREE_RETURN_IF_ERROR(constant(c, i, LOOM_SCALAR_TYPE_INDEX, &component));
+      IREE_RETURN_IF_ERROR(binary(c, loom_index_add_build, base_lane, component,
+                                  &c->mapped_lane));
+      IREE_RETURN_IF_ERROR(fresh_remap(c, oldf));
+      IREE_RETURN_IF_ERROR(
+          clone_value(c, loom_vector_insert_value(op), &scalar));
+      int64_t dynamic = INT64_MIN;
+      IREE_RETURN_IF_ERROR(loom_vector_insert_build(
+          &c->rw.builder, scalar, packed, &component, 1, &dynamic, 1, payload,
+          op->location, &made));
+      packed = loom_vector_insert_result(made);
+    }
+    c->run_values = NULL;
+    c->run_classes = NULL;
+    c->mapped_lane = base_lane;
+    *result = packed;
+    return iree_ok_status();
+  }
+  IREE_RETURN_IF_ERROR(fresh_remap(c, oldf));
+  loom_value_id_t condition;
+  IREE_RETURN_IF_ERROR(clone_value(c, loom_scf_if_condition(op), &condition));
+  loom_op_t* branch = NULL;
+  IREE_RETURN_IF_ERROR(loom_scf_if_build(
+      &c->rw.builder, LOOM_SCF_IF_BUILD_FLAG_HAS_ELSE_REGION, condition,
+      &payload, 1, NULL, 0, op->location, &branch));
+  unsigned ordinal =
+      loom_value_def_index(loom_value_table_const_value(&c->module->values, v));
+  for (unsigned r = 0; r < 2; ++r) {
+    loom_builder_ip_t ip = loom_builder_enter_region(
+        &c->rw.builder, branch, loom_op_regions(branch)[r]);
+    loom_op_t* yield = loom_region_entry_block(loom_op_regions(op)[r])->last_op;
+    loom_value_id_t packed;
+    IREE_RETURN_IF_ERROR(
+        load_converted_run(c, loom_scf_yield_values(yield).values[ordinal],
+                           carried, oldf, payload, &packed));
+    loom_op_t* terminator = NULL;
+    IREE_RETURN_IF_ERROR(loom_scf_yield_build(&c->rw.builder, &packed, 1,
+                                              op->location, &terminator));
+    loom_builder_restore(&c->rw.builder, ip);
+  }
+  *result = loom_scf_if_results(branch).values[0];
+  return iree_ok_status();
+}
+static iree_status_t load_converted(context_t* c, loom_value_id_t v,
+                                    loom_value_id_t carried,
+                                    loom_value_id_t oldf,
+                                    loom_type_t scalar_type,
+                                    loom_value_id_t* result) {
+  loom_op_t* op = defining(c, v);
+  if (v == carried) {
+    loom_op_t* init = defining(
+        c, loom_scf_for_iter_args(c->producer)
+               .values[loom_value_def_index(loom_value_table_const_value(
+                           &c->module->values, v)) -
+                       1]);
+    loom_op_t* value = NULL;
+    IREE_RETURN_IF_ERROR(loom_scalar_constant_build(
+        &c->rw.builder, loom_vector_constant_value(init), scalar_type,
+        c->producer->location, &value));
+    *result = loom_scalar_constant_result(value);
+    return iree_ok_status();
+  }
+  IREE_RETURN_IF_ERROR(fresh_remap(c, oldf));
+  if (loom_vector_insert_isa(op))
+    return clone_value(c, loom_vector_insert_value(op), result);
+  loom_value_id_t condition;
+  IREE_RETURN_IF_ERROR(clone_value(c, loom_scf_if_condition(op), &condition));
+  loom_op_t* branch = NULL;
+  IREE_RETURN_IF_ERROR(loom_scf_if_build(
+      &c->rw.builder, LOOM_SCF_IF_BUILD_FLAG_HAS_ELSE_REGION, condition,
+      &scalar_type, 1, NULL, 0, op->location, &branch));
+  unsigned ordinal =
+      loom_value_def_index(loom_value_table_const_value(&c->module->values, v));
+  for (unsigned r = 0; r < 2; ++r) {
+    loom_builder_ip_t ip = loom_builder_enter_region(
+        &c->rw.builder, branch, loom_op_regions(branch)[r]);
+    loom_op_t* yield = loom_region_entry_block(loom_op_regions(op)[r])->last_op;
+    loom_value_id_t scalar;
+    IREE_RETURN_IF_ERROR(
+        load_converted(c, loom_scf_yield_values(yield).values[ordinal], carried,
+                       oldf, scalar_type, &scalar));
+    loom_op_t* terminator = NULL;
+    IREE_RETURN_IF_ERROR(loom_scf_yield_build(&c->rw.builder, &scalar, 1,
+                                              op->location, &terminator));
+    loom_builder_restore(&c->rw.builder, ip);
+  }
+  *result = loom_scf_if_results(branch).values[0];
+  return iree_ok_status();
+}
+static iree_status_t rewrite(context_t* c, loom_op_t* fragment,
+                             uint16_t ordinal, bool vector_load) {
+  loom_value_id_t first_generated = c->module->values.count;
+  loom_op_t* old = c->producer;
+  loom_block_t* old_block = loom_region_entry_block(loom_scf_for_body(old));
+  loom_type_t payload =
+      loom_module_value_type(c->module, loom_vector_fragment_data(fragment));
+  loom_scalar_type_t element = loom_type_element_type(payload);
+  unsigned slot = element == LOOM_SCALAR_TYPE_BF16;
+  loom_op_t* op = NULL;
+  if (c->staging[slot] == LOOM_VALUE_ID_INVALID) {
+    loom_block_t* entry =
+        loom_region_entry_block(loom_func_like_body(c->function));
+    loom_builder_set_before(&c->rw.builder, entry->first_op);
+    loom_value_id_t bytes, zero;
+    IREE_RETURN_IF_ERROR(constant(c, 4352, LOOM_SCALAR_TYPE_OFFSET, &bytes));
+    IREE_RETURN_IF_ERROR(constant(c, 0, LOOM_SCALAR_TYPE_OFFSET, &zero));
+    IREE_RETURN_IF_ERROR(loom_buffer_alloca_build(
+        &c->rw.builder, bytes, 16, LOOM_VALUE_FACT_MEMORY_SPACE_WORKGROUP,
+        loom_type_buffer(), old->location, &op));
+    loom_value_id_t buffer = loom_buffer_alloca_result(op);
+    IREE_RETURN_IF_ERROR(loom_encoding_layout_dense_build(
+        &c->rw.builder,
+        loom_type_encoding_with_role(LOOM_ENCODING_ROLE_ADDRESS_LAYOUT),
+        old->location, &op));
+    loom_type_t view = loom_type_shaped_1d(LOOM_TYPE_VIEW, element,
+                                           loom_dim_pack_static(2176), 0);
+    view.encoding_id = (uint16_t)loom_encoding_layout_dense_result(op);
+    view.encoding_flags = LOOM_ENCODING_FLAG_SSA;
+    IREE_RETURN_IF_ERROR(loom_buffer_view_build(&c->rw.builder, buffer, zero,
+                                                view, old->location, &op));
+    c->staging[slot] = loom_buffer_view_result(op);
+    c->workgroup_bytes += 4352;
+  }
+  loom_value_id_t staging = c->staging[slot];
+  loom_builder_set_before(&c->rw.builder, old);
+  loom_value_id_t zero, one, eight, sixteen, thirtytwo, stride, lid;
+  IREE_RETURN_IF_ERROR(constant(c, 0, LOOM_SCALAR_TYPE_INDEX, &zero));
+  IREE_RETURN_IF_ERROR(constant(c, 1, LOOM_SCALAR_TYPE_INDEX, &one));
+  IREE_RETURN_IF_ERROR(constant(c, 8, LOOM_SCALAR_TYPE_INDEX, &eight));
+  IREE_RETURN_IF_ERROR(constant(c, 16, LOOM_SCALAR_TYPE_INDEX, &sixteen));
+  IREE_RETURN_IF_ERROR(constant(c, 32, LOOM_SCALAR_TYPE_INDEX, &thirtytwo));
+  IREE_RETURN_IF_ERROR(constant(c, 136, LOOM_SCALAR_TYPE_INDEX, &stride));
+  IREE_RETURN_IF_ERROR(loom_kernel_workitem_id_build(
+      &c->rw.builder, LOOM_KERNEL_DIMENSION_X,
+      loom_type_scalar(LOOM_SCALAR_TYPE_INDEX), old->location, &op));
+  lid = loom_kernel_workitem_id_result(op);
+  loom_value_id_t row, colbase, oldf, tmp;
+  IREE_RETURN_IF_ERROR(binary(c, loom_index_div_build, lid, sixteen, &row));
+  IREE_RETURN_IF_ERROR(binary(c, loom_index_rem_build, lid, sixteen, &tmp));
+  IREE_RETURN_IF_ERROR(binary(c, loom_index_mul_build, tmp, eight, &colbase));
+  IREE_RETURN_IF_ERROR(binary(c, loom_index_rem_build, row, eight, &oldf));
+  loom_value_id_t yielded =
+      loom_scf_yield_values(old_block->last_op).values[ordinal];
+  loom_value_id_t carried = loom_block_arg_id(old_block, ordinal + 1);
+  loom_value_id_t packed = LOOM_VALUE_ID_INVALID;
+  loom_value_id_t wave, half, low;
+  IREE_RETURN_IF_ERROR(binary(c, loom_index_div_build, colbase, sixteen, &tmp));
+  IREE_RETURN_IF_ERROR(binary(c, loom_index_mul_build, tmp, thirtytwo, &wave));
+  IREE_RETURN_IF_ERROR(binary(c, loom_index_div_build, row, eight, &tmp));
+  IREE_RETURN_IF_ERROR(binary(c, loom_index_mul_build, tmp, sixteen, &half));
+  IREE_RETURN_IF_ERROR(binary(c, loom_index_rem_build, colbase, sixteen, &low));
+  IREE_RETURN_IF_ERROR(binary(c, loom_index_add_build, wave, half, &tmp));
+  IREE_RETURN_IF_ERROR(
+      binary(c, loom_index_add_build, tmp, low, &c->mapped_lane));
+  bool packed_run = vector_load || uniform_masks(c, yielded, carried);
+  if (vector_load) {
+    IREE_RETURN_IF_ERROR(load_run(c, yielded, carried, oldf, payload, &packed));
+  } else if (packed_run) {
+    IREE_RETURN_IF_ERROR(
+        load_converted_run(c, yielded, carried, oldf, payload, &packed));
+  }
+  loom_op_t* producer = NULL;
+  IREE_RETURN_IF_ERROR(loom_scf_for_build(
+      &c->rw.builder, LOOM_SCF_FOR_BUILD_FLAG_HAS_UNROLL_POLICY, zero, eight,
+      one, NULL, 0, NULL, 0, NULL, 0, LOOM_VALUE_ID_INVALID,
+      LOOM_SCF_FOR_UNROLL_POLICY_UNROLL, 0, old->location, &producer));
+  loom_builder_ip_t ip = loom_builder_enter_region(&c->rw.builder, producer,
+                                                   loom_scf_for_body(producer));
+  loom_block_t* block = loom_region_entry_block(loom_scf_for_body(producer));
+  loom_value_id_t component = loom_block_arg_id(block, 0), column;
+  IREE_RETURN_IF_ERROR(
+      binary(c, loom_index_add_build, colbase, component, &column));
+  loom_value_slice_t initial = loom_scf_for_iter_args(old);
+  loom_value_id_t result;
+  int64_t dynamic = INT64_MIN;
+  loom_value_id_t scalar, at;
+  if (packed_run) {
+    IREE_RETURN_IF_ERROR(loom_vector_extract_build(
+        &c->rw.builder, packed, &component, 1, &dynamic, 1,
+        loom_type_scalar(element), old->location, &op));
+    scalar = loom_vector_extract_result(op);
+  } else {
+    IREE_RETURN_IF_ERROR(binary(c, loom_index_add_build, c->mapped_lane,
+                                component, &c->mapped_lane));
+    IREE_RETURN_IF_ERROR(load_converted(c, yielded, carried, oldf,
+                                        loom_type_scalar(element), &scalar));
+  }
+  IREE_RETURN_IF_ERROR(binary(c, loom_index_mul_build, row, stride, &tmp));
+  IREE_RETURN_IF_ERROR(binary(c, loom_index_add_build, tmp, column, &at));
+  IREE_RETURN_IF_ERROR(loom_view_store_build(&c->rw.builder, 0, scalar, staging,
+                                             &at, 1, &dynamic, 1, 0, 0,
+                                             old->location, &op));
+  IREE_RETURN_IF_ERROR(
+      loom_scf_yield_build(&c->rw.builder, NULL, 0, old->location, &op));
+  loom_builder_restore(&c->rw.builder, ip);
+  IREE_RETURN_IF_ERROR(barrier(c));
+  loom_value_id_t lane, base;
+  IREE_RETURN_IF_ERROR(binary(c, loom_index_rem_build, lid, thirtytwo, &lane));
+  IREE_RETURN_IF_ERROR(binary(c, loom_index_div_build, lane, sixteen, &tmp));
+  IREE_RETURN_IF_ERROR(binary(c, loom_index_mul_build, tmp, eight, &row));
+  IREE_RETURN_IF_ERROR(binary(c, loom_index_div_build, lid, thirtytwo, &tmp));
+  IREE_RETURN_IF_ERROR(binary(c, loom_index_mul_build, tmp, sixteen, &wave));
+  IREE_RETURN_IF_ERROR(binary(c, loom_index_rem_build, lane, sixteen, &tmp));
+  IREE_RETURN_IF_ERROR(binary(c, loom_index_add_build, wave, tmp, &base));
+  loom_value_id_t init = initial.values[ordinal];
+  loom_op_t* consumer = NULL;
+  IREE_RETURN_IF_ERROR(loom_scf_for_build(
+      &c->rw.builder, LOOM_SCF_FOR_BUILD_FLAG_HAS_UNROLL_POLICY, zero, eight,
+      one, &init, 1, &payload, 1, NULL, 0, LOOM_VALUE_ID_INVALID,
+      LOOM_SCF_FOR_UNROLL_POLICY_UNROLL, 0, old->location, &consumer));
+  ip = loom_builder_enter_region(&c->rw.builder, consumer,
+                                 loom_scf_for_body(consumer));
+  block = loom_region_entry_block(loom_scf_for_body(consumer));
+  component = loom_block_arg_id(block, 0);
+  IREE_RETURN_IF_ERROR(binary(c, loom_index_add_build, row, component, &tmp));
+  IREE_RETURN_IF_ERROR(binary(c, loom_index_mul_build, tmp, stride, &at));
+  IREE_RETURN_IF_ERROR(binary(c, loom_index_add_build, at, base, &tmp));
+  IREE_RETURN_IF_ERROR(
+      loom_view_load_build(&c->rw.builder, 0, staging, &tmp, 1, &dynamic, 1, 0,
+                           0, loom_type_scalar(element), old->location, &op));
+  scalar = loom_view_load_result(op);
+  IREE_RETURN_IF_ERROR(loom_vector_insert_build(
+      &c->rw.builder, scalar, loom_block_arg_id(block, 1), &component, 1,
+      &dynamic, 1, payload, old->location, &op));
+  result = loom_vector_insert_result(op);
+  IREE_RETURN_IF_ERROR(
+      loom_scf_yield_build(&c->rw.builder, &result, 1, old->location, &op));
+  loom_builder_restore(&c->rw.builder, ip);
+  IREE_RETURN_IF_ERROR(barrier(c));
+  IREE_RETURN_IF_ERROR(loom_rewriter_replace_all_uses_with(
+      &c->rw, loom_scf_for_results(old).values[ordinal],
+      loom_scf_for_results(consumer).values[0]));
+  IREE_RETURN_IF_ERROR(
+      loom_rewriter_set_operand(&c->rw, old_block->last_op, ordinal,
+                                loom_block_arg_id(old_block, ordinal + 1)));
+  // Cloned producer definitions may move into an ancestor scope. Reusing
+  // their authored display names there would shadow the original values when
+  // the transformed module is printed and parsed again.
+  for (loom_value_id_t v = first_generated; v < c->module->values.count; ++v) {
+    IREE_RETURN_IF_ERROR(loom_module_clear_value_name(c->module, v));
+  }
+  loom_pass_mark_changed(c->pass);
+  return iree_ok_status();
+}
+static iree_status_t report(context_t* c, loom_op_t* op, const char* outcome,
+                            const char* reason) {
+  if (!c->report) return iree_ok_status();
+  loom_symbol_ref_t symbol = loom_func_like_callee(c->function);
+  const loom_symbol_t* entry = &c->module->symbols.entries[symbol.symbol_id];
+  const loom_target_compile_report_source_low_transform_row_t row = {
+      .function_name = c->module->strings.entries[entry->name_id],
+      .source_op_name = loom_op_name(c->module, op),
+      .source_op_kind = op->kind,
+      .transform_key = IREE_SV("stage-matrix-operands"),
+      .outcome = iree_make_cstring_view(outcome),
+      .reason = iree_make_cstring_view(reason),
+      .candidate_value_count = 1,
+      .selected_value_count = !strcmp(outcome, "selected"),
+      .row_count = 16,
+      .column_count = 128,
+      .workgroup_memory_byte_count = 4352,
+      .inserted_barrier_op_count = !strcmp(outcome, "selected") ? 2 : 0,
+  };
+  return loom_target_compile_report_record_source_low_transform_row(c->report,
+                                                                    &row);
+}
+static iree_status_t count_storage(void* user, loom_op_t* op,
+                                   const loom_walk_context_t* walk,
+                                   loom_walk_result_t* result) {
+  (void)walk;
+  *result = LOOM_WALK_CONTINUE;
+  context_t* c = user;
+  if (!loom_buffer_alloca_isa(op) || loom_buffer_alloca_memory_space(op) !=
+                                         LOOM_VALUE_FACT_MEMORY_SPACE_WORKGROUP)
+    return iree_ok_status();
+  int64_t bytes = 0;
+  if (!loom_value_facts_as_exact_i64(
+          loom_rewriter_value_facts(&c->rw, loom_buffer_alloca_byte_length(op)),
+          &bytes) ||
+      bytes < 0 || bytes > INT32_MAX)
+    c->unknown_storage = true;
+  else
+    c->workgroup_bytes += ((uint64_t)bytes + 15) & ~UINT64_C(15);
+  return iree_ok_status();
+}
+static iree_status_t collect(void* user, loom_op_t* op,
+                             const loom_walk_context_t* walk,
+                             loom_walk_result_t* result) {
+  (void)walk;
+  *result = LOOM_WALK_CONTINUE;
+  context_t* c = user;
+  if (!loom_vector_fragment_isa(op) ||
+      loom_vector_fragment_role(op) != LOOM_VECTOR_ROLE_RHS)
+    return iree_ok_status();
+  IREE_RETURN_IF_ERROR(iree_arena_grow_array(
+      c->pass->arena, c->count, c->count + 1, sizeof(*c->candidates),
+      &c->capacity, (void**)&c->candidates));
+  c->candidates[c->count++] = op;
+  return iree_ok_status();
+}
+iree_status_t loom_stage_matrix_operands_run(loom_pass_t* pass,
+                                             loom_module_t* module,
+                                             loom_func_like_t function) {
+  if (!loom_kernel_def_isa(function.op) || !loom_func_like_body(function))
+    return iree_ok_status();
+  context_t c = {.pass = pass,
+                 .module = module,
+                 .function = function,
+                 .staging = {LOOM_VALUE_ID_INVALID, LOOM_VALUE_ID_INVALID}};
+  c.report = loom_low_pass_capability_compile_report(
+      loom_low_pass_capability_from_pass(pass));
+  loom_walk_result_t walk;
+  IREE_RETURN_IF_ERROR(loom_walk_function(module, function, LOOM_WALK_PRE_ORDER,
+                                          (loom_walk_callback_t){collect, &c},
+                                          pass->arena, &walk));
+
+  if (!c.count) return iree_ok_status();
+  const loom_target_facts_t* target = NULL;
+  bool resolved = false;
+  IREE_RETURN_IF_ERROR(loom_target_pass_resolve_function_facts(
+      pass, module, function, &resolved, &target));
+  const loom_target_bundle_t* bundle =
+      resolved ? loom_target_facts_bundle(target) : NULL;
+
+  if (!bundle || !bundle->snapshot || bundle->snapshot->subgroup_size != 32)
+    return iree_ok_status();
+  loom_value_fact_table_t* facts = NULL;
+  IREE_RETURN_IF_ERROR(loom_pass_value_facts_prepare(
+      pass, module,
+      loom_pass_value_fact_scope_function_for_target(function, target),
+      &facts));
+  loom_target_workgroup_size_t size = {0};
+  if (!loom_kernel_def_static_workgroup_size_from_facts(module, function.op,
+                                                        facts, &size))
+    return iree_ok_status();
+
+  c.storage_limit = bundle->snapshot->max_workgroup_storage_bytes;
+  uint32_t flat = 0;
+  if (!loom_target_workgroup_size_flat_product_u32(&size, &flat) ||
+      flat != 256 || size.x != 256 || size.y != 1 || size.z != 1)
+    return iree_ok_status();
+  IREE_RETURN_IF_ERROR(loom_rewriter_initialize(&c.rw, module, pass->arena));
+  iree_status_t status = loom_rewriter_enable_analysis(&c.rw, function, facts);
+  loom_control_uniformity_info_initialize(module, facts, pass->arena,
+                                          &c.uniformity);
+  if (iree_status_is_ok(status))
+    status = loom_walk_function(module, function, LOOM_WALK_PRE_ORDER,
+                                (loom_walk_callback_t){count_storage, &c},
+                                pass->arena, &walk);
+  for (iree_host_size_t i = 0; iree_status_is_ok(status) && i < c.count; ++i) {
+    loom_op_t* fragment = c.candidates[i];
+    loom_value_id_t data = loom_vector_fragment_data(fragment);
+    loom_type_t type = loom_module_value_type(module, data);
+    uint64_t n = 0;
+    if (!loom_type_static_element_count(type, &n) || n != 8 ||
+        (loom_type_element_type(type) != LOOM_SCALAR_TYPE_BF16 &&
+         loom_type_element_type(type) != LOOM_SCALAR_TYPE_F16) ||
+        !exact(&c, loom_vector_fragment_rows(fragment), 16) ||
+        !exact(&c, loom_vector_fragment_columns(fragment), 16))
+      continue;
+
+    c.producer = defining(&c, data);
+    if (!c.producer || !loom_scf_for_isa(c.producer) ||
+        !exact(&c, loom_scf_for_lower_bound(c.producer), 0) ||
+        !exact(&c, loom_scf_for_upper_bound(c.producer), 8) ||
+        !exact(&c, loom_scf_for_step(c.producer), 1))
+      continue;
+    loom_block_t* block =
+        loom_region_entry_block(loom_scf_for_body(c.producer));
+    uint16_t ordinal = loom_value_def_index(
+        loom_value_table_const_value(&module->values, data));
+
+    bool has_load = false;
+    if (!pointwise(&c, loom_scf_yield_values(block->last_op).values[ordinal],
+                   loom_block_arg_id(block, ordinal + 1),
+                   loom_block_arg_id(block, 0), &has_load) ||
+        !has_load)
+      continue;
+
+    bool valid = true;
+    for (uint16_t j = 0; j < c.producer->result_count; ++j) {
+      bool read = false;
+      if (!pointwise(&c, loom_scf_yield_values(block->last_op).values[j],
+                     loom_block_arg_id(block, j + 1),
+                     loom_block_arg_id(block, 0), &read))
+        valid = false;
+    }
+    if (!valid) continue;
+    status =
+        iree_arena_allocate_array(pass->arena, module->values.count,
+                                  sizeof(*c.dependence), (void**)&c.dependence);
+    if (!iree_status_is_ok(status)) break;
+    memset(c.dependence, 0, module->values.count);
+    for (loom_op_t* child = block->first_op; child; child = child->next_op)
+      if (!independent_body(child) || !check_external(&c, child)) {
+        valid = false;
+        break;
+      }
+    if (!valid) {
+      continue;
+    }
+    bool uniform = false;
+    loom_control_uniformity_failure_t failure = {0};
+    status = loom_control_uniformity_prove_execution(
+        &c.uniformity, c.producer, LOOM_VALUE_FACT_UNIFORM_SCOPE_WORKGROUP,
+        &failure, &uniform);
+    if (!iree_status_is_ok(status)) break;
+    if (!uniform) {
+      status =
+          report(&c, fragment, "declined", "control_not_workgroup_uniform");
+      continue;
+    }
+
+    unsigned slot = loom_type_element_type(type) == LOOM_SCALAR_TYPE_BF16;
+    uint64_t extra = c.staging[slot] == LOOM_VALUE_ID_INVALID ? 4352 : 0;
+    if (c.unknown_storage || !c.storage_limit ||
+        c.workgroup_bytes + extra > c.storage_limit) {
+      status = report(&c, fragment, "declined", "workgroup_storage_budget");
+      continue;
+    }
+    loom_value_id_t yielded =
+        loom_scf_yield_values(block->last_op).values[ordinal];
+    loom_value_id_t carried = loom_block_arg_id(block, ordinal + 1);
+    bool vector_load = vectorizable(&c, yielded, carried);
+    bool coalesced = false;
+    if (!vector_load &&
+        (!convertible(&c, yielded, carried, &coalesced) || !coalesced)) {
+      status = report(&c, fragment, "declined", "no_contiguous_vector_run");
+      continue;
+    }
+    status = rewrite(&c, fragment, ordinal, vector_load);
+    if (iree_status_is_ok(status))
+      status = report(&c, fragment, "selected",
+                      vector_load ? "cooperative_vector_load"
+                                  : "cooperative_converted_load");
+  }
+  loom_rewriter_deinitialize(&c.rw);
+  if (pass->value_facts)
+    loom_pass_value_fact_owner_invalidate(pass->value_facts);
+  return status;
+}
