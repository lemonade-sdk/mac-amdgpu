+  graph::Array ordinary_zero = graph::Array::zeros(
+      first_carries[0].in->shape, DType::kF32);
+  std::vector<float> zero_values(ordinary_zero.shape().elem_count(), -1.0f);
+  LSE_EXPECT_OK(ordinary_zero.to_host(zero_values.data(),
