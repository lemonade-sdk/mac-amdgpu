+        case math::MatrixElem::kI8: a_format = b_format = "i8"; break;
+        case math::MatrixElem::kSU8: a_format = "i8"; b_format = "u8"; break;
+        case math::MatrixElem::kFp8: a_format = b_format = "f8e4m3"; break;
